# INACTIVE DRAFT. Outside .github/workflows; package remains private:true.
# Review exact repository/npm identity, terms and trusted-publisher permissions
# under separate publication authorization. Pin reviewed action SHAs before use.
# Based on https://github.com/n8n-io/n8n-nodes-starter/blob/master/.github/workflows/publish.yml
name: Reviewed provenance release
on:
  workflow_dispatch:
jobs:
  publish:
    if: ${{ false }} # Deliberate second guard; no publication approved.
    runs-on: ubuntu-latest
    permissions:
      contents: read
      id-token: write
    steps:
      - uses: actions/checkout@v4 # Replace with reviewed immutable SHA.
      - uses: actions/setup-node@v4 # Replace with reviewed immutable SHA.
        with:
          node-version: '24'
          registry-url: 'https://registry.npmjs.org'
      - run: npm ci --ignore-scripts
      - run: npm run typecheck
      - run: npm run build
      - run: npm test
      - run: npm run lint
      - run: npm publish --provenance --access public
# No tokens, repository identity, publisher setup or active automation included.
